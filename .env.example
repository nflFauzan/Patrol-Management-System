# ==============================================================================
# ENVIRONMENT VARIABLES - PATROL MANAGEMENT SYSTEM (ENTERPRISE)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL 18 + PostGIS Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=patrol_admin
DB_PASSWORD=patrol_secret_2026
DB_NAME=patrol_management
DATABASE_URL=postgresql://patrol_admin:patrol_secret_2026@localhost:5432/patrol_management?schema=public

# Redis 7 Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_patrol_secret

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_patrol_access_jwt_key_2026_xyz!
JWT_REFRESH_SECRET=super_secret_patrol_refresh_jwt_key_2026_xyz!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# S3 Object Storage (MinIO Local / Cloudflare R2 / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ACCESS_KEY=minio_patrol_admin
S3_SECRET_KEY=minio_patrol_secret_2026
S3_BUCKET_NAME=patrol-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# WhatsApp Gateway (Fonnte / Wablas)
WA_GATEWAY_PROVIDER=fonnte
WA_GATEWAY_URL=https://api.fonnte.com/send
WA_API_TOKEN=your_fonnte_or_wablas_api_token_here
WA_EMERGENCY_GROUP_ID=120363028392819283@g.us
WA_NOTIFICATIONS_ENABLED=true

# Client URLs (CORS)
WEB_ADMIN_URL=http://localhost:3000
PWA_FIELD_URL=http://localhost:3001
