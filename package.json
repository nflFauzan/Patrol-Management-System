{
  "name": "patrol-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Patrol & Facility Management System (Single-Tenant In-House)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@patrol/backend",
    "dev:admin": "npm run dev --workspace=@patrol/web-admin",
    "dev:pwa": "npm run dev --workspace=@patrol/pwa-field",
    "gateway": "node scripts/local-gateway.js",
    "dev:start": "start-dev.bat",
    "dev:stop": "stop-dev.bat",
    "clean:ram": "scripts\\clean-node.bat",
    "preview": "start-preview.bat",
    "dev": "npm run dev:backend",
    "build": "npm run build --workspaces",
    "typecheck:admin": "npm run typecheck --workspace=@patrol/web-admin",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "npm run lint --workspaces",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "keywords": [
    "patrol",
    "security",
    "facility-management",
    "postgis",
    "nestjs",
    "pwa"
  ],
  "author": "Engineering Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/http-proxy": "^1.17.17",
    "http-proxy": "^1.18.1"
  }
}
